# Database
DATABASE_URL=postgresql://user:password@localhost:5432/zapcentral

# API server
PORT=8080
# Porta do dev server do Vite (apenas local; no Replit fica vazia)
APP_PORT=5173
# Base path do frontend
BASE_PATH=/
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# URL publica do tunel (ngrok) ou dominio de producao. Necessaria para
# registrar os webhooks de Telegram e Evolution, que exigem HTTPS.
PUBLIC_URL=

# Clerk authentication
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PROXY_URL=

# First-admin setup secret
BOOTSTRAP_SECRET=replace_with_a_long_random_value

# Evolution API / WhatsApp
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=replace_with_evolution_api_key

# Replit-managed values (normally injected automatically on Replit)
REPLIT_DEV_DOMAIN=